{{!
    @template local_mediar/barras

    Barras horizontales de porcentaje con etiqueta y valor visibles (no dependen del color).
    El punto de color identifica el área; "Reforzar" marca lo que está bajo el umbral.

    Example context (json):
    {
        "barras": [{"nombre": "Geometría", "areanombre": "Matemáticas", "color": "#FF5D1C", "pct": "50", "ancho": 50,
                    "reforzar": true, "n": 355}]
    }
}}
<ul class="mediar-barras">
    {{#barras}}
    <li class="mediar-barra">
        <div class="mediar-barra-texto">
            <span class="mediar-barra-nombre">
                {{#conpunto}}<span class="mediar-punto" style="background-color: {{color}}" aria-hidden="true"></span>{{/conpunto}}
                {{nombre}}
                {{#areanombre}}<span class="mediar-barra-area">{{areanombre}}</span>{{/areanombre}}
            </span>
            <span class="mediar-barra-valor">
                {{#reforzar}}<span class="badge mediar-badge-reforzar">{{#pix}}i/warning, core{{/pix}} {{#str}}reforzar, local_mediar{{/str}}</span>{{/reforzar}}
                {{pct}} {{unidad}}
            </span>
        </div>
        <div class="mediar-barra-pista" role="img" aria-label="{{nombre}}: {{pct}} {{unidad}}">
            <div class="mediar-barra-relleno" style="width: {{ancho}}%"></div>
        </div>
    </li>
    {{/barras}}
</ul>
