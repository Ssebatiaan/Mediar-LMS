{{!
    @template local_mediar/proximas

    Panel "Próximas actividades": línea de tiempo con fecha, actividad (enlace) y curso.

    Example context (json):
    {
        "total": 2, "hayitems": true, "urltodas": "#", "urlcalendario": "#",
        "items": [{"dia": "26 de noviembre", "hora": "17:00", "titulo": "Cierre de Cuadernillo 3",
                   "curso": "MATEMÁTICAS-1119-2027", "url": "#", "escierre": true, "pronto": true}]
    }
}}
<section class="mediar-panel mediar-proximas" aria-labelledby="mediar-proximas-titulo">
    <header class="mediar-panel-header">
        <h2 id="mediar-proximas-titulo" class="mediar-panel-titulo">
            {{#str}}proximas, local_mediar{{/str}}
            <span class="mediar-contador" aria-label="{{#str}}totalproximas, local_mediar, {{total}}{{/str}}">{{total}}</span>
        </h2>
        <a class="mediar-enlace-suave" href="{{urltodas}}">{{#str}}vertodas, local_mediar{{/str}}</a>
    </header>
    {{#hayitems}}
    <ol class="mediar-timeline">
        {{#items}}
        <li class="mediar-timeline-item{{#escierre}} es-cierre{{/escierre}}{{#pronto}} es-pronto{{/pronto}}">
            <span class="mediar-timeline-punto" aria-hidden="true"></span>
            <div class="mediar-timeline-fecha">{{dia}} • {{hora}}</div>
            <a class="mediar-timeline-titulo" href="{{url}}">{{titulo}}</a>
            <div class="mediar-timeline-curso">{{curso}}</div>
        </li>
        {{/items}}
    </ol>
    {{/hayitems}}
    {{^hayitems}}
    <p class="mediar-vacio">{{#str}}sinproximas, local_mediar{{/str}}</p>
    {{/hayitems}}
    <a class="btn mediar-btn-suave w-100" href="{{urlcalendario}}">
        {{#pix}}i/calendar, core{{/pix}} {{#str}}vercalendario, local_mediar{{/str}}
    </a>
</section>
