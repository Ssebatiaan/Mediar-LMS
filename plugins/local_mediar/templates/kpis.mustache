{{!
    @template local_mediar/kpis

    Fila de indicadores (cifra grande + etiqueta + detalle).

    Example context (json):
    {
        "kpis": [{"etiqueta": "Último simulacro", "valor": "295", "unidad": "/500", "detalle": "+11 frente al anterior",
                  "detallebueno": true, "destacado": true}]
    }
}}
<div class="mediar-kpis">
    {{#kpis}}
    <div class="mediar-kpi{{#destacado}} es-destacado{{/destacado}}">
        <span class="mediar-kpi-etiqueta">{{etiqueta}}</span>
        <span class="mediar-kpi-valor">{{valor}}{{#unidad}}<small>{{unidad}}</small>{{/unidad}}</span>
        {{#detalle}}
        <span class="mediar-kpi-detalle{{#detallebueno}} es-bueno{{/detallebueno}}{{#detallemalo}} es-malo{{/detallemalo}}">{{detalle}}</span>
        {{/detalle}}
    </div>
    {{/kpis}}
</div>
