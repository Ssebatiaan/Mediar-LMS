{{!
    @template local_mediartest/admin

    Administración del test: participación, distribución por dimensión, resultados e instrumentos.

    Example context (json):
    {
        "activo": "Test de preferencias de estudio · 1.0", "kpis": [], "dimensiones": [], "haydimensiones": false,
        "filas": [], "instrumentos": [], "urlexportar": "#", "puedegestionar": true, "formulario": ""
    }
}}
<div class="mediar-pagina mediartest">
    <p class="mediar-subtitulo">{{#str}}instrumentoactivo, local_mediartest{{/str}}: <strong>{{activo}}</strong> · {{#str}}privacidadadmin, local_mediartest{{/str}}</p>
    {{> local_mediar/kpis }}

    {{#haydimensiones}}
    <section class="mediar-panel">
        <h3 class="mediar-panel-titulo">{{#str}}distribucion, local_mediartest{{/str}}</h3>
        <p class="mediar-ayuda">{{#str}}distribucion_ayuda, local_mediartest{{/str}}</p>
        <ul class="mediartest-distribucion">
            {{#dimensiones}}
            <li>
                <div class="mediartest-distribucion-nombre">{{nombre}}</div>
                <div class="mediartest-distribucion-barra" role="img"
                     aria-label="{{poloa}}: {{na}} · {{#str}}equilibrada, local_mediartest{{/str}}: {{ne}} · {{polob}}: {{nb}}">
                    {{#pa}}<span class="es-a" style="width: {{pa}}%">{{poloa}} {{na}}</span>{{/pa}}
                    {{#pe}}<span class="es-e" style="width: {{pe}}%">{{ne}}</span>{{/pe}}
                    {{#pb}}<span class="es-b" style="width: {{pb}}%">{{polob}} {{nb}}</span>{{/pb}}
                </div>
            </li>
            {{/dimensiones}}
        </ul>
        <p class="mediar-ayuda mb-0"><span class="mediartest-leyenda es-a"></span> {{#str}}leyenda_a, local_mediartest{{/str}}
            <span class="mediartest-leyenda es-e"></span> {{#str}}equilibrada, local_mediartest{{/str}}
            <span class="mediartest-leyenda es-b"></span> {{#str}}leyenda_b, local_mediartest{{/str}}</p>
    </section>
    {{/haydimensiones}}

    <section class="mediar-panel">
        <header class="mediar-panel-header">
            <h3 class="mediar-panel-titulo">{{#str}}resultadosestudiantes, local_mediartest{{/str}}</h3>
            <a class="btn btn-sm mediar-btn-suave" href="{{urlexportar}}">{{#str}}exportarexcel, local_mediartest{{/str}}</a>
        </header>
        <div class="table-responsive">
            <table class="table mediar-tabla-datos mb-0">
                <thead><tr>
                    <th scope="col">{{#str}}estudiante, local_mediartest{{/str}}</th>
                    <th scope="col">{{#str}}colegio, local_mediartest{{/str}}</th>
                    <th scope="col">{{#str}}estado, local_mediartest{{/str}}</th>
                    <th scope="col">{{#str}}perfil, local_mediartest{{/str}}</th>
                    <th scope="col">{{#str}}fecha, local_mediartest{{/str}}</th>
                </tr></thead>
                <tbody>
                {{#filas}}
                    <tr>
                        <td>{{#finalizado}}<a href="{{url}}">{{nombre}}</a>{{/finalizado}}{{^finalizado}}{{nombre}}{{/finalizado}}</td>
                        <td class="mediar-ayuda">{{cohorte}}</td>
                        <td>
                            {{#finalizado}}<span class="badge text-bg-success">{{#str}}finalizado, local_mediartest{{/str}}</span>{{/finalizado}}
                            {{#enprogreso}}<span class="badge mediar-badge-pendiente">{{#str}}enprogreso, local_mediartest{{/str}}</span>{{/enprogreso}}
                            {{^finalizado}}{{^enprogreso}}<span class="text-muted small">{{#str}}sinpresentar, local_mediartest{{/str}}</span>{{/enprogreso}}{{/finalizado}}
                        </td>
                        <td class="fw-semibold">{{perfil}}</td>
                        <td>{{fecha}}</td>
                    </tr>
                {{/filas}}
                </tbody>
            </table>
        </div>
    </section>

    <section class="mediar-panel">
        <h3 class="mediar-panel-titulo">{{#str}}instrumentos, local_mediartest{{/str}}</h3>
        <p class="mediar-ayuda">{{#str}}instrumentos_ayuda, local_mediartest{{/str}}</p>
        <div class="table-responsive">
            <table class="table mediar-tabla-datos">
                <thead><tr>
                    <th scope="col">{{#str}}instrumento, local_mediartest{{/str}}</th>
                    <th scope="col" class="text-center">{{#str}}version, local_mediartest{{/str}}</th>
                    <th scope="col" class="text-center">{{#str}}dimensiones, local_mediartest{{/str}}</th>
                    <th scope="col" class="text-center">{{#str}}afirmaciones, local_mediartest{{/str}}</th>
                    <th scope="col" class="text-center">{{#str}}finalizados, local_mediartest{{/str}}</th>
                    <th scope="col"></th>
                </tr></thead>
                <tbody>
                {{#instrumentos}}
                    <tr>
                        <td><strong>{{nombre}}</strong> <span class="mediar-codigo">{{codigo}}</span></td>
                        <td class="text-center">{{version}}</td>
                        <td class="text-center">{{dimensiones}}</td>
                        <td class="text-center">{{items}}</td>
                        <td class="text-center">{{intentos}}</td>
                        <td class="text-end">
                            {{#activo}}<span class="badge text-bg-success">{{#str}}activo, local_mediartest{{/str}}</span>{{/activo}}
                            {{#urlactivar}}<a class="btn btn-sm mediar-btn-suave" href="{{urlactivar}}">{{#str}}activar, local_mediartest{{/str}}</a>{{/urlactivar}}
                        </td>
                    </tr>
                {{/instrumentos}}
                </tbody>
            </table>
        </div>
        {{#puedegestionar}}
        <h4 class="mediartest-subtitulo">{{#str}}cargarnuevo, local_mediartest{{/str}}</h4>
        {{{formulario}}}
        {{/puedegestionar}}
    </section>
</div>
