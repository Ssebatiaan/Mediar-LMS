{{!
    @template core/login_panel

    MEDIAR: panel izquierdo de la página de acceso (sobrescribe el de Boost).
    Si el sitio tiene "instrucciones de acceso" configuradas, se muestran en lugar del texto.

    Example context (json):
    {
        "leftinstructions": ""
    }
}}
<div class="mediar-login-panel">
    <div class="mediar-login-panel-icono" aria-hidden="true"></div>
    {{^leftinstructions}}
        <p class="mediar-login-eyebrow">{{#str}}login:eyebrow, theme_mediar{{/str}}</p>
        <h1 class="mediar-login-title">{{#str}}login:title, theme_mediar{{/str}}</h1>
        <p class="mediar-login-description">{{#str}}login:description, theme_mediar{{/str}}</p>
        <div class="mediar-login-stats">
            <div class="mediar-login-stat">
                <strong>{{#str}}login:stat1value, theme_mediar{{/str}}</strong>
                <span>{{#str}}login:stat1, theme_mediar{{/str}}</span>
            </div>
            <div class="mediar-login-stat">
                <strong>{{#str}}login:stat2value, theme_mediar{{/str}}</strong>
                <span>{{#str}}login:stat2, theme_mediar{{/str}}</span>
            </div>
            <div class="mediar-login-stat">
                <strong>{{#str}}login:stat3value, theme_mediar{{/str}}</strong>
                <span>{{#str}}login:stat3, theme_mediar{{/str}}</span>
            </div>
        </div>
    {{/leftinstructions}}
    {{#leftinstructions}}
        <div class="mediar-login-description">{{{leftinstructions}}}</div>
    {{/leftinstructions}}
    <p class="mediar-login-tagline">{{#str}}login:tagline, theme_mediar{{/str}}</p>
</div>
